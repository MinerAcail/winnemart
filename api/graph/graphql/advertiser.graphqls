type PromoCode {
  id: String!
  advertiserID: String!
  promoCode: String!
  vendorId: String!
  discountApplied: Float!
  createdAt: String!
}

type GeneratedPromoCode {
  id: String!
  promoCodeID: String!
  customerNumber: String!
  totalAmount: Float!
  orderID:String
  createdAt: String!
}
type vendorinfor {
  Vendor: Vendor
  items: [Product]
}
type productData {
  id: String
  newPrice: String!
}

type NewData{
  orderId:String
  items:[productData]
}

extend type Query {
  getPromoCode(vendorId: String): PromoCode!
  getAllPromoCode: [PromoCode!]!
  getOrdersWithPromo(orderID:String): GeneratedPromoCode!
  getAllOrdersWithPromo: [GeneratedPromoCode]!
  # getAllOrdersWithPromo: [GeneratedPromoCode]!
  getOrderPromoDetails(orderId:String!):[Order]
  getAllVendors: [vendorinfor!]!
  checkPromoCode(productIds: [String!]!, promoCode: String!): [productData]!
  priceWithPromocode(orderIDs: [String!]!): [NewData]!
}
extend type Mutation {
  generatePromoCode(vendorId: String!): PromoCode!
  applyPromoCode(
    orderID: String!
    promoCode: String!
  ): GeneratedPromoCode!
}
